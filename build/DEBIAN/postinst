#!/bin/bash
set -e

case "$1" in
    configure)
        # Read the configured package version; $2 is the previous version.
        VERSION=$(dpkg-query -W -f='${Version}' "${DPKG_MAINTSCRIPT_PACKAGE:-terminal-router}" 2>/dev/null) || VERSION="unknown"
        echo ""
        echo "=================================================="
        echo "  Terminal Router $VERSION installed"
        echo "=================================================="
        echo "  Logging is opt-in; existing user setups are preserved."
        echo "  To enable logging:"
        echo "    terminal-router              router left, AI observer right"
        echo "    terminal-router claude|codex  choose the AI engine explicitly"
        echo "    terminal-router install      record every terminal"
        echo "    terminal-router launch        one session only, no dotfile edits"
        echo ""
        echo "  Status:  terminal-router status"
        echo "  Setup:   terminal-router menu"
        echo "  Remove:  terminal-router remove"
        echo "  Docs:    man terminal-router"
        echo ""
        echo "  Menu: Networking and SysLinuxOS Tools. MATE caches the menu;"
        echo "  log out and back in if the entry does not appear yet."
        echo ""
        echo "  Note: logs capture screen output, including secrets passed"
        echo "  as plaintext command-line arguments. Use terminal-router pause before"
        echo "  sensitive work."
        echo "  The AI workspace sends captured output to your AI provider;"
        echo "  normal account usage applies. :auto off pauses automatic analysis."
        echo ""
        ;;
esac
exit 0
