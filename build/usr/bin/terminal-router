#!/bin/bash
# terminal-router — front-end for the per-user tmux session logger.
#
# Records every interactive terminal into ~/.claude-logs so Claude Code can
# follow a live router CLI session in real time without any access to the
# device itself.
#
# Usage: terminal-router <command> (see help)

set -uo pipefail

VERSION="1.3.7"
INSTALLER="/usr/share/terminal-router/install.sh"
CONSENT="$HOME/.config/terminal-router/consent"
source /usr/share/terminal-router/common.sh || exit 1

die() { echo "terminal-router: $*" >&2; exit 1; }

require_user() {
    [ "$(id -u)" -eq 0 ] && die "do not run as root/sudo — this configures the calling user's HOME."
    return 0
}

is_installed() {
    grep -qF "$MARK_BEGIN" "$RCFILE" 2>/dev/null
}

# The log this sets up only has a point if something reads it: space-separated
# names of the AI assistant CLIs found on PATH, empty if none. codex ships via
# nvm on some setups, so it is only found once the shell that sources nvm is
# the one running this check. Launched from a desktop menu entry, this runs in
# a non-interactive shell: ~/.bashrc's own "not interactive? return" guard
# skips PATH/nvm setup entirely, so claude/codex look missing even when
# installed. Fall back to the common install locations directly in that case.
assistant_status() {
    local found="" p
    command -v claude > /dev/null 2>&1 && found="$found claude"
    command -v codex > /dev/null 2>&1 && found="$found codex"

    if [[ "$found" != *claude* ]]; then
        for p in "$HOME/.local/bin/claude" "$HOME"/.nvm/versions/node/*/bin/claude; do
            [ -x "$p" ] && { found="$found claude"; break; }
        done
    fi
    if [[ "$found" != *codex* ]]; then
        for p in "$HOME/.local/bin/codex" "$HOME"/.nvm/versions/node/*/bin/codex; do
            [ -x "$p" ] && { found="$found codex"; break; }
        done
    fi

    echo "${found# }"
}

warn_no_assistant() {
    if [ -z "$(assistant_status)" ]; then
        echo >&2
        echo "WARN  no AI assistant CLI found on PATH (claude, codex) — this log has" >&2
        echo "      nothing to read it yet. Install one, or ignore if you read logs" >&2
        echo "      some other way." >&2
    fi
}

# ---------------------------------------------------------------- consent ---
show_warning() {
    cat <<'WARN'

  SECURITY NOTICE — read before enabling

  terminal-router records everything printed in your terminals to files under
  ~/.claude-logs (directory 0700, files 0600, deleted automatically after 30
  days).

  Passwords typed at an interactive prompt (sudo, SSH password auth) are NOT
  captured, because the terminal does not echo them.

  Secrets that DO end up in the log are the ones visible on screen:
    - passwords passed as command-line arguments (mysql -pXXX)
    - tokens in headers (curl -H "Authorization: Bearer ...")
    - the output of `cat` on a .env file or a private key
    - anything you export or paste in plain sight

  Use `terminal-router pause` before such work and `terminal-router resume`
  afterwards, inside the pane being recorded.

WARN
}

ensure_consent() {
    [ -f "$CONSENT" ] && return 0
    show_warning
    read -rp "  Enable terminal session logging? [y/N] " ans
    case "$ans" in
        y|Y|yes|YES)
            mkdir -p "$(dirname "$CONSENT")" || return 1
            (umask 077; printf 'accepted %s by %s\n' "$(date -Is)" "$(id -un)" > "$CONSENT") || return 1
            chmod 600 "$CONSENT" || return 1
            return 0
            ;;
        *)
            echo "  Aborted, nothing was changed."
            return 1
            ;;
    esac
}

# ---------------------------------------------------------------- actions ---
cmd_install() {
    require_user
    [ -x "$INSTALLER" ] || die "installer missing: $INSTALLER"
    ensure_consent || return 1
    bash "$INSTALLER" || return $?
    warn_no_assistant
}

cmd_launch() {
    require_user
    [ -n "${TMUX:-}" ] && die "already inside a tmux session — detach first (Ctrl+b d), then run 'terminal-router launch' from a plain shell."
    [ -x "$INSTALLER" ] || die "installer missing: $INSTALLER"
    ensure_consent || return 1
    bash "$INSTALLER" logdir-only || return $?
    warn_no_assistant

    # Session-scoped hooks (no -g) log only this session's windows/splits and
    # vanish with it — nothing is written to ~/.tmux.conf. Piping the pane
    # tmux starts new-session with directly is unreliable (verified: pipe-pane
    # chained onto, or run against, that first pane silently no-ops), so the
    # hooks are set first and then a throwaway window 0 is swapped for a
    # window created after them, which the after-new-window hook does pipe.
    local hook='exec "$HOME/.claude-logs/pipe-logger.sh" #{q:session_name} #I #P'
    local session="router-$$"
    local first_window

    first_window=$(tmux new-session -d -P -F '#{window_id}' -s "$session") || die "could not create tmux session"
    if ! tmux set-hook -t "$session" after-new-window "pipe-pane -o '$hook'" ||
       ! tmux set-hook -t "$session" after-split-window "pipe-pane -o '$hook'" ||
       ! tmux new-window -t "$session" ||
       ! tmux kill-window -t "$first_window"; then
        tmux kill-session -t "$session" 2>/dev/null || true
        die "could not configure logging; the new session was closed."
    fi

    echo
    echo "Logging only this terminal. ~/.bashrc, ~/.zshrc and ~/.tmux.conf are"
    echo "untouched, so every other terminal (Terminator included) is unaffected."
    echo "Detach with Ctrl+b d to return to a plain shell; logging continues."
    echo "Use terminal-router pause/resume inside the pane; exit ends the session."
    echo
    exec tmux attach -t "$session"
}

cmd_remove() {
    require_user
    echo "== terminal-router: remove =="

    for f in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.tmux.conf"; do
        valid_block "$f" || die "unbalanced or duplicate markers in $f; no files changed."
    done

    for f in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.tmux.conf"; do
        if [ -f "$f" ] && ! grep -qF "$MARK_BEGIN" "$f" 2>/dev/null &&
           grep -qE 'logpause\(\)|claude-logs/pipe-logger\.sh' "$f" 2>/dev/null; then
            echo "WARN  $f holds an older, unmarked setup." >&2
            echo "      It cannot be removed automatically: without the markers" >&2
            echo "      there is no safe way to tell where the block ends." >&2
            echo "      Delete the tmux auto-start and logpause/logresume" >&2
            echo "      sections by hand." >&2
            echo >&2
        fi
    done

    local removed=0
    for f in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.tmux.conf"; do
        if [ -f "$f" ] && grep -qF "$MARK_BEGIN" "$f"; then
            cp -a "$f" "$f.terminal-router.bak" || die "could not back up $f"
            sed -i "$SED_RANGE" "$f" || die "could not update $f"
            echo "OK    block removed from $f (backup: $f.terminal-router.bak)"
            removed=1
        else
            echo "SKIP  $f (no block found)"
        fi
    done

    if command -v crontab > /dev/null 2>&1; then
        local cron_list
        cron_list=$(crontab -l 2>/dev/null || true)
        if printf '%s\n' "$cron_list" | has_rotation; then
            printf '%s\n' "$cron_list" | without_rotation | crontab - || die "could not update crontab"
            echo "OK    crontab rotation entry removed"
        else
            echo "SKIP  crontab (no rotation entry)"
        fi
    else
        echo "SKIP  crontab (no rotation entry)"
    fi

    if [ -d "$LOGDIR" ]; then
        local n sz
        n=$(find "$LOGDIR" -maxdepth 1 -name 'tmux-*.log' 2>/dev/null | wc -l)
        sz=$(du -sh "$LOGDIR" 2>/dev/null | cut -f1)
        echo
        echo "  $LOGDIR still holds $n log file(s), $sz."
        read -rp "  Delete it permanently? [y/N] " ans
        case "$ans" in
            y|Y|yes|YES) rm -rf "$LOGDIR"; echo "OK    $LOGDIR deleted" ;;
            *)           echo "SKIP  $LOGDIR kept" ;;
        esac
    fi

    rm -f "$CONSENT"

    echo
    if [ "$removed" -eq 1 ]; then
        echo "Done. Open a new terminal for the change to take effect."
        echo "Already-running tmux sessions keep logging until they exit"
        echo "(force now with: tmux kill-server — closes all tmux sessions)."
    else
        echo "Nothing was installed for this user."
    fi
}

workspace_panes() {
    local socket
    for socket in "$LOGDIR"/workspace-*/tmux.sock; do
        [ -S "$socket" ] || continue
        tmux -S "$socket" list-panes -a -F '  #{session_name}:#{window_index}.#{pane_index} (#{pane_id}) #{@terminal_router_role} pipe=#{pane_pipe}' 2>/dev/null || true
    done
}

cmd_status() {
    echo "terminal-router $VERSION — status for user $(id -un)"
    echo

    local legacy=0
    for f in "$RCFILE" "$HOME/.tmux.conf"; do
        if [ -f "$f" ] && ! grep -qF "$MARK_BEGIN" "$f" 2>/dev/null &&
           grep -qE 'logpause\(\)|claude-logs/pipe-logger\.sh' "$f" 2>/dev/null; then
            legacy=1
        fi
    done

    if is_installed; then
        echo "  shell hook      ACTIVE     ($RCFILE)"
    else
        echo "  shell hook      not set    ($RCFILE)"
    fi

    if grep -qF "$MARK_BEGIN" "$HOME/.tmux.conf" 2>/dev/null; then
        echo "  tmux hooks      ACTIVE     (~/.tmux.conf)"
    else
        echo "  tmux hooks      not set    (~/.tmux.conf)"
    fi

    if [ "$legacy" -eq 1 ]; then
        echo "  legacy setup    FOUND, unmarked — install and remove are blocked"
        echo "                  (an older hand-edited setup without markers)"
    fi

    if command -v crontab > /dev/null 2>&1 && crontab -l 2>/dev/null | has_rotation; then
        echo "  log rotation    ACTIVE     (daily 03:00, keeps 30 days)"
    else
        echo "  log rotation    not set"
    fi

    local assistants
    assistants=$(assistant_status)
    if [ -n "$assistants" ]; then
        echo "  AI assistant    found      ($assistants)"
    else
        echo "  AI assistant    NOT FOUND  (claude, codex) — nothing to read this log"
    fi

    if command -v tmux > /dev/null 2>&1 && tmux show-hooks -g 2>/dev/null | grep -q pipe-pane; then
        echo "  running server  hooks loaded"
    else
        echo "  running server  no tmux server, or hooks not loaded yet"
    fi

    echo
    if [ -d "$LOGDIR" ]; then
        local n sz
        n=$(find "$LOGDIR" -maxdepth 1 -name 'tmux-*.log' 2>/dev/null | wc -l)
        sz=$(du -sh "$LOGDIR" 2>/dev/null | cut -f1)
        echo "  logs            $n file(s), $sz in $LOGDIR"
        if [ -L "$LOGDIR/latest" ]; then
            echo "  latest          $(readlink -f "$LOGDIR/latest")"
        else
            echo "  latest          (no symlink yet — open a new terminal)"
        fi
    else
        echo "  logs            $LOGDIR does not exist"
    fi

    if command -v tmux > /dev/null 2>&1; then
        echo
        echo "  tmux sessions:"
        tmux ls 2>/dev/null | sed 's/^/    /' || echo "    (none)"
        echo "  integrated workspaces:"
        workspace_panes
    fi
}

cmd_tail() {
    [ -e "$LOGDIR/latest" ] || die "no log yet — run 'terminal-router launch', or install and open a new terminal."
    echo "Following $(readlink -f "$LOGDIR/latest")  (Ctrl+C to stop)"
    echo
    tail -F --max-unchanged-stats=1 "$LOGDIR/latest"
}

require_pane() {
    require_user
    [ -n "${TMUX:-}" ] && [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] ||
        die "run this command inside a tmux pane."
}

cmd_pause() {
    require_pane
    tmux pipe-pane -t "$TMUX_PANE" || die "could not pause this pane."
    echo "[logging suspended for pane $TMUX_PANE]"
}

cmd_resume() {
    require_pane
    [ "$(tmux show-options -pqv -t "$TMUX_PANE" @terminal_router_role)" != assistant ] ||
        die "the assistant pane is not recorded; resume from the router pane."
    [ -f "$CONSENT" ] || die "logging not enabled; run 'terminal-router launch' or 'terminal-router install' first."
    [ -x "$LOGDIR/pipe-logger.sh" ] || die "logger missing; re-run 'terminal-router install' or 'terminal-router launch'."
    local active
    active=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pipe}') || die "could not inspect this pane."
    if [ "$active" = 1 ]; then
        echo "[pane $TMUX_PANE already has an active pipe; unchanged]"
        return 0
    fi
    tmux pipe-pane -o -t "$TMUX_PANE" 'exec "$HOME/.claude-logs/pipe-logger.sh" #{q:session_name} #I #P #{q:@terminal_router_log_key}' ||
        die "could not resume this pane."
    echo "[logging resumed for pane $TMUX_PANE, new file]"
}

cmd_doctor() {
    local failed=0 f target panes
    echo "terminal-router $VERSION — diagnostics (read-only)"
    if command -v tmux >/dev/null 2>&1; then
        echo "OK    $(tmux -V)"
    else
        echo "FAIL  tmux missing; install the tmux package."
        failed=1
    fi
    if [ -f "$CONSENT" ] && [ -x "$LOGDIR/pipe-logger.sh" ]; then
        echo "OK    consent and logger present"
    else
        echo "FAIL  setup incomplete; run terminal-router install or launch."
        failed=1
    fi
    if [ -d "$LOGDIR" ] && [ -O "$LOGDIR" ] && [ "$(stat -c %a "$LOGDIR")" = 700 ]; then
        echo "OK    log directory owned by current user, mode 0700"
        if [ -n "$(find "$LOGDIR" -maxdepth 1 -type f -name 'tmux-*.log' -perm /077 -print -quit)" ]; then
            echo "FAIL  log files readable by other users; set log permissions to 0600."
            failed=1
        fi
    else
        echo "FAIL  log directory missing, wrong owner or mode; expected 0700 at $LOGDIR"
        failed=1
    fi
    for f in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.tmux.conf"; do
        if ! valid_block "$f"; then
            echo "FAIL  unbalanced or duplicate markers: $f"
            failed=1
        fi
    done
    if [ -L "$LOGDIR/latest" ]; then
        target=$(readlink -f "$LOGDIR/latest")
        if [[ "$target" == "$(readlink -f "$LOGDIR")"/tmux-*.log ]] && [ -f "$target" ]; then
            echo "OK    latest points to an existing log"
        else
            echo "FAIL  latest is broken or outside the log directory; start/resume a logged pane."
            failed=1
        fi
    else
        echo "WARN  no latest log yet; start a logged session."
    fi
    if ! command -v crontab >/dev/null 2>&1 || ! crontab -l 2>/dev/null | has_rotation; then
        echo "WARN  rotation not configured; install cron and re-run setup."
    fi
    panes=$({ tmux list-panes -a -F '  #{session_name}:#{window_index}.#{pane_index} (#{pane_id}) pipe=#{pane_pipe}' 2>/dev/null || true; workspace_panes; })
    if [ -n "$panes" ]; then
        echo "Live panes (pipe=1 means a pipe is open, not proof of disk writes):"
        printf '%s\n' "$panes"
    else
        echo "WARN  no running tmux panes."
    fi
    return "$failed"
}

cmd_menu() {
    while true; do
        clear 2>/dev/null || true
        cmd_status
        echo
        echo "  ------------------------------------------------------------"
        if is_installed; then
            echo "  1) Re-run setup (repair / update)"
            echo "  2) Remove setup for this user"
        else
            echo "  1) Enable terminal logging (every terminal)"
            echo "  2) Remove setup for this user"
        fi
        echo "  3) Follow the live log"
        echo "  4) Show the security notice"
        echo "  5) Open router + AI workspace (two panes)"
        echo "  6) Diagnose logging and permissions"
        echo "  7) Launch a single logged session without AI"
        echo "  q) Quit"
        echo
        read -rp "  Choice: " choice
        echo
        case "$choice" in
            1) cmd_install ;;
            2) cmd_remove ;;
            3) cmd_tail ;;
            4) show_warning ;;
            5) source "${INSTALLER%/*}/workspace.sh"; cmd_workspace ;;
            6) cmd_doctor ;;
            7) cmd_launch ;;
            q|Q|"") exit 0 ;;
            *) echo "  Unknown choice." ;;
        esac
        echo
        read -rsn1 -p "  Press any key to return to the menu... "
        echo
    done
}

cmd_help() {
    cat <<EOF
terminal-router $VERSION — router terminal with a live AI observer

Records every interactive terminal to ~/.claude-logs so Claude Code can follow
a live router CLI session (Cisco/Huawei over SSH) in real time. Claude reads the
log and suggests; you stay the only one touching the device.

Usage: terminal-router [claude|codex|command]

  (no args) Open two side-by-side panes: router and AI observer
  claude    Open the workspace with Claude Code
  codex     Open the workspace with Codex
  workspace [claude|codex]   Same integrated workspace
  install   Set up the shell and tmux hooks for the current user (every terminal)
  launch    Log only this terminal, one-shot — no ~/.bashrc/~/.zshrc/~/.tmux.conf edits
  remove    Remove them again (with backups) and optionally delete the logs
  status    Show what is active and how much has been logged
  doctor    Check setup, permissions and live panes (read-only; exit 1 on errors)
  tail      Follow the most recent pane log
  pause     Suspend capture in the calling tmux pane
  resume    Resume capture in the calling pane (also works with launch)
  menu      Configuration menu and alternate launch options
  help      This text

Inside a logged pane: terminal-router pause / resume suspend and resume capture.
After install, logpause / logresume are shortcuts. Detaching does not stop logging.
In the AI pane: ask questions, Enter to analyse now, :auto off/on, :quit.
Only router output is recorded and sent to the AI provider; account usage applies.

Everything is per-user and lives in \$HOME. Never run this with sudo.
See /usr/share/doc/terminal-router/README for details.
EOF
}

case "${1:-workspace}" in
    workspace)      source "${INSTALLER%/*}/workspace.sh"; cmd_workspace "${2:-}" ;;
    claude|codex)   source "${INSTALLER%/*}/workspace.sh"; cmd_workspace "$1" ;;
    install)        cmd_install ;;
    launch|single)  cmd_launch ;;
    remove|uninstall) cmd_remove ;;
    status)         cmd_status ;;
    doctor)         cmd_doctor ;;
    pause)          cmd_pause ;;
    resume)         cmd_resume ;;
    tail|log|follow) cmd_tail ;;
    menu)           cmd_menu ;;
    help|-h|--help) cmd_help ;;
    version|-V|--version) echo "terminal-router $VERSION" ;;
    *)              cmd_help; exit 1 ;;
esac
